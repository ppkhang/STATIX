{
  "name": "statix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "check:holds": "node --env-file-if-exists=.env.local --import tsx scripts/check-holds.ts",
    "invites:release": "node --env-file-if-exists=.env.local --import tsx scripts/release-invites.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "test": "node --import tsx --test src/lib/drop-status.test.ts src/lib/auth-rules.test.ts src/lib/waitlist-rules.test.ts src/lib/manage-token.test.ts src/lib/invite-rules.test.ts src/lib/purchase-rules.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.16.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.7"
  }
}
