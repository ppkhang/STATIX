# Copy to .env.local and fill in. Never commit real values.

# Database (local default matches docker-compose.yml)
DATABASE_URL=postgres://statix:statix@localhost:5432/statix

# Auth.js (M2)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# true when self-hosting (including `next start` on your machine); not needed on Vercel
AUTH_TRUST_HOST=
# public address of the site, used for links in emails
APP_URL=
# 1 = print emails and codes to the server log in a local production build. Never on a real host.
STUB_SENDERS=

# Email (M3)
RESEND_API_KEY=
EMAIL_FROM=

# Payments (M4, sandbox first)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# Shipping (M4)
GHN_TOKEN=
GHN_SHOP_ID=

# Bot check (M7)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
